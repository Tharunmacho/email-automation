# ============================================================================
#  Resume Ingestion Pipeline — environment configuration
#  Copy to `.env` and fill in. Never commit the real .env.
# ============================================================================

# ---- Application ----
APP_ENV=development                 # development | production
LOG_LEVEL=INFO

# ---- Email Provider Choice ----
# "smtp_imap" (Standard Email/Password via SMTP & IMAP) | "gmail" (Google OAuth2 API)
EMAIL_PROVIDER=smtp_imap

# ---- SMTP (Outgoing Auto-Reply Emails) ----
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ---- IMAP (Incoming Resume Email Ingestion) ----
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your_email@gmail.com
IMAP_PASSWORD=your_app_password
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX
IMAP_PROCESSED_FOLDER=Resumes/Processed
IMAP_DELETED_FOLDER=Resumes/Deleted

# ---- Gmail API (Google OAuth2 - Legacy / Alternative) ----
# Path to the OAuth client credentials JSON downloaded from Google Cloud Console
# (APIs & Services -> Credentials -> OAuth 2.0 Client ID -> Desktop app).
GMAIL_CREDENTIALS_FILE=secrets/gmail_credentials.json
# Where the user's OAuth token is cached after first consent (auto-created).
GMAIL_TOKEN_FILE=secrets/gmail_token.json
# Gmail search query used to pre-filter candidate emails (see Gmail search syntax).
# Exclude both label buckets below, or handled mail comes back on every poll.
GMAIL_QUERY=has:attachment -label:Resumes/Processed -label:Resumes/Deleted
# After successful processing, mark the message as read and/or apply a label.
GMAIL_MARK_READ=true
GMAIL_PROCESSED_LABEL=Resumes/Processed
# Applied when a candidate is deleted in the app: retires that exact email so it
# is never re-ingested. A NEW email carrying the same resume is unlabelled and
# ingests as a new candidate. Nothing is ever deleted from Gmail.
GMAIL_DELETED_LABEL=Resumes/Deleted
# Max messages to pull per poll cycle.
GMAIL_MAX_RESULTS=25

# ---- Anthropic Claude ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Cost-efficient, high-quality parser model. Override if you prefer another.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=4096

# ---- MongoDB ----
# Paste your full connection string here (e.g. MongoDB Atlas SRV string).
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=resume_ats
MONGO_CANDIDATES_COLLECTION=candidates

# ---- File storage ----
# gridfs = store original PDFs/images INSIDE the same MongoDB (a GridFS bucket).
# local  = store them on local disk instead.
STORAGE_BACKEND=gridfs              # gridfs | local
STORAGE_GRIDFS_BUCKET=resumes       # GridFS bucket/collection name
STORAGE_LOCAL_DIR=data/resumes      # only used when STORAGE_BACKEND=local

# ---- OCR ----
# Only needed if Tesseract isn't on PATH. Point to the tesseract executable.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANGUAGES=eng
# If an extracted text layer is shorter than this many chars, treat the PDF as
# scanned and fall back to OCR.
OCR_MIN_TEXT_CHARS=120

# How a scanned application bundle is read. A scan has no text layer, so the
# pages holding the CV cannot be picked until something has been read: the
# document is OCR'd a chunk at a time and stops as soon as the CV is located.
#
# Worked example, a 50-page bundle with the CV on pages 25-26:
#   chunk 1 (pages 1-10)   certificates      → keep going
#   chunk 2 (pages 11-20)  marksheets, ID    → keep going
#   chunk 3 (pages 21-30)  CV found on 25-26 → STOP
# Pages 31-50 are never rendered, never uploaded, never billed, and only the
# text of pages 25-26 is sent to the LLM.
#
# Chunk size is also the stopping granularity: larger means fewer round trips
# but more overshoot past the CV.
OCR_CHUNK_PAGES=10
# Hard ceiling on pages OCR'd from one document, so a 200-page mis-send cannot
# run forever. Truncation is always logged, never silent.
OCR_MAX_PAGES=60
# Give up early on a scan that is not an application at all: after this many
# pages with neither a CV nor any supporting document (certificate, experience
# letter, ID), no CV is coming. Certificates do NOT trip this — a CV behind
# twenty of them is the case the page classifier exists for.
OCR_GIVE_UP_PAGES=4

# ---- Stage 1 (what gets opened at all) ----
# How strong the "this is a resume email" signal must be from headers alone.
DETECTOR_MIN_SCORE=0.70
# Open every attachment and judge it on its contents, whatever it is called.
# `01.pdf`, `Scan_2026.pdf` and `image.png` are what candidates actually send,
# and a filename cannot be trusted in either direction. Set false to fall back
# to DETECTOR_MIN_SCORE alone, which is cheaper and misses real candidates.
INSPECT_ALL_DOCUMENTS=true
# Images cannot be read without OCR, so they are screened on size rather than
# name. 2 KB admits a re-compressed phone photo of a CV (typically 15-30 KB)
# while still excluding signature logos and UI icons. This is the main lever on
# OCR spend once INSPECT_ALL_DOCUMENTS is on — raise it if the bill gets loud.
MIN_IMAGE_ATTACHMENT_BYTES=2000

# ---- Background jobs (Celery + Redis) ----
# Start Redis with `docker compose up -d redis`, then run a worker:
#   celery -A app.tasks.celery_app worker --loglevel=INFO --concurrency=4
# and, for the every-2-minutes automatic poll, a scheduler alongside it:
#   celery -A app.tasks.celery_app beat --loglevel=INFO
# The scheduler queues one task per email, so --concurrency is how many resumes
# are extracted at once. (--pool=solo runs them one at a time; on Windows, where
# prefork is unavailable, use --pool=threads --concurrency=4 instead.)
# Without a worker the API falls back to running polls inline, as before.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Redis instance backing the ingestion locks, which stop a manual sync and a
# scheduled one from processing the same inbox at the same time.
REDIS_URL=redis://localhost:6379/0
# Seconds a single batch cycle (the manual sync) may hold the poll lock before
# it is presumed dead. Must exceed a worst-case batch, or a second cycle can
# start on a live one.
POLL_LOCK_TTL_SECONDS=1800
# The same lock, held by the scheduled poller — which only searches Gmail and
# queues the work, so it is sized for a slow search rather than for a batch.
POLL_DISPATCH_LOCK_TTL_SECONDS=120
# Seconds one email stays claimed by the worker processing it. This is what
# keeps two workers off the same resume now that the poll lock is released
# before the queued work has run. Size it for one message, not for a batch.
MESSAGE_LOCK_TTL_SECONDS=900

# ---- WhatsApp bot integration ----
# The recruitment bot's credential for POST /candidates, presented as
# `X-Service-Key`. Deliberately NOT the staff JWT: a staff token identifies a
# person and expires in hours, this identifies a service and lives until it is
# rotated. Sharing one would mean a leaked recruiter session could inject
# candidates, and rotating the bot's key would sign every recruiter out.
#
# Unset is a closed door: POST /candidates rejects every request rather than
# serving an unauthenticated write endpoint.
WHATSAPP_SERVICE_KEY=

# Path to the CV policy table (JSON). Unset uses the built-in rules in
# app/policy/cv_policy.py. The table decides, per destination country and job
# category, whether a candidate must supply a CV — and it is the CRM's decision,
# never the caller's. Unknown combinations default to requiring one, which is
# the safe direction: an unnecessary CV costs a question, a missing one costs a
# placement.
CV_POLICY_PATH=
